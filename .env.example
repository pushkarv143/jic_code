# Copy this file to .env (same directory as docker-compose.yml) and fill
# in real values before running `docker compose up`. `.env` is read
# automatically by docker compose and substituted into docker-compose.yml
# via the ${VAR} / ${VAR:-default} syntax.

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# Root password for the mysql service. The backend container also connects
# as `root` using this same password (DB_PASSWORD in docker-compose.yml) -
# there is no separate app-specific DB user in this setup.
MYSQL_ROOT_PASSWORD=change_me_root_password

# ---------------------------------------------------------------------------
# Backend - JWT
# ---------------------------------------------------------------------------
# HMAC signing secret for access/refresh tokens (app.jwt.secret in
# application.yml). application.yml ships a dev-only default if this is
# left unset, but ALWAYS set a long, random, unique value for anything
# beyond local experimentation.
JWT_SECRET=change_me_to_a_long_random_base64_secret

# ---------------------------------------------------------------------------
# Backend - mail (spring-boot-starter-mail, used for password-reset /
# notification emails). Leave MAIL_USERNAME/MAIL_PASSWORD blank to run
# without real email delivery - the app still starts, sends just fail/log.
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
