# Copy this file to .env (same directory as docker-compose.yml) and fill
# in real values before running `docker compose up`. `.env` is read
# automatically by docker compose and substituted into docker-compose.yml
# via the ${VAR} / ${VAR:-default} syntax.

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# Root password for the mysql service. The backend container also connects
# as `root` using this same password (DB_PASSWORD in docker-compose.yml) -
# there is no separate app-specific DB user in this setup.
MYSQL_ROOT_PASSWORD=change_me_root_password

# ---------------------------------------------------------------------------
# Backend - JWT
# ---------------------------------------------------------------------------
# HMAC signing secret for access/refresh tokens (app.jwt.secret in
# application.yml). application.yml ships a dev-only default if this is
# left unset, but ALWAYS set a long, random, unique value for anything
# beyond local experimentation.
JWT_SECRET=change_me_to_a_long_random_base64_secret

# ---------------------------------------------------------------------------
# Backend - mail (spring-boot-starter-mail, used for password-reset /
# notification emails). Leave MAIL_USERNAME/MAIL_PASSWORD blank to run
# without real email delivery - the app still starts, sends just fail/log.
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Backend - SMS, used only for one-time passcodes. Leave blank and the app runs
# normally with SMS unavailable: a passcode asked for by phone is refused with a
# clear message instead of being accepted and dropped.
#
# Fill all three to switch the gateway on. The token is an API credential, so it
# belongs here rather than in the compose file.
#
# Reaching Indian numbers reliably needs DLT registration with the provider
# before delivery is dependable, whichever provider you choose.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+91

# ---------------------------------------------------------------------------
# Backend - WhatsApp (Twilio)
# Reuses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN above.
# Set TWILIO_WHATSAPP_FROM to enable the daily timetable reminder over WhatsApp.
#   Sandbox (dev):    whatsapp:+14155238886
#   Production:       whatsapp:+91XXXXXXXXXX  (your approved Business number)
# Leave blank to disable — the app still starts normally without it.
# ---------------------------------------------------------------------------
TWILIO_WHATSAPP_FROM=
