# =====================================================================
# Environment for the school-backend systemd service.
#
# Install to /etc/school-backend/school-backend.env, owned by root,
# chmod 600 — it holds the database password and the JWT signing key.
#
# systemd parses this file itself, not a shell: do NOT quote values, do
# NOT use $VAR substitution, and do not put a space around the '='.
# =====================================================================

SPRING_PROFILES_ACTIVE=prod

# ---------------------------------------------------------------------
# Database
#
# localhost, because MySQL runs on this same instance. That is also why
# the deployed app is unaffected by port 3306 being closed to the
# outside world — it never leaves the box.
# ---------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/school_management_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace_with_real_password

# ---------------------------------------------------------------------
# JWT signing key
#
# MUST be replaced. application.yml ships a well-known development
# default, and anyone who has seen this repository could forge a valid
# admin token against a server still using it.
#
# Generate:  openssl rand -base64 64 | tr -d '\n'
# ---------------------------------------------------------------------
JWT_SECRET=replace_with_openssl_rand_base64_64

# ---------------------------------------------------------------------
# Frontend origin
#
# CORS_ALLOWED_ORIGINS must match the browser's origin exactly —
# scheme, host and port. A trailing slash makes it fail to match.
# ---------------------------------------------------------------------
FRONTEND_URL=http://132.226.191.38
CORS_ALLOWED_ORIGINS=http://132.226.191.38

# ---------------------------------------------------------------------
# Uploads.
#
# Absolute path, not ~/app/uploads: systemd does not expand `~`, and the
# service runs with its own environment rather than a login shell, so a
# tilde here would be taken literally and create a directory called "~".
#
# Kept outside the jar so a redeploy never wipes uploaded files.
#
# Resulting layout:
#   /home/ubuntu/app/uploads/student-id-pictures/<uuid>.jpg
#   /home/ubuntu/app/uploads/documents/<uuid>.pdf
#   /home/ubuntu/app/uploads/materials/<uuid>.pdf
# ---------------------------------------------------------------------
UPLOAD_DIR=/home/ubuntu/app/uploads
UPLOAD_PHOTOS_SUBDIR=student-id-pictures
UPLOAD_DOCUMENTS_SUBDIR=documents
UPLOAD_MATERIALS_SUBDIR=materials

# ---------------------------------------------------------------------
# Mail (optional). Leave blank to run without delivery — the app still
# starts and password-reset sends simply fail and log.
# ---------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@school.edu

# ---------------------------------------------------------------------
# WhatsApp (Twilio)
#
# Uses the same TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN as SMS.
# Only the sender number differs:
#   Development:  whatsapp:+14155238886 (Twilio Sandbox)
#   Production:   whatsapp:+91XXXXXXXXXX (approved Business number)
#
# Leave blank to disable the WhatsApp channel; the app still starts
# and timetable reminders are simply not sent.
# ---------------------------------------------------------------------
TWILIO_WHATSAPP_FROM=
